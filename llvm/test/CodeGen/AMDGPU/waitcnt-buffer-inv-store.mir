# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck --check-prefix=GFX94 %s
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck --check-prefix=GFX94 %s

# TODO: These tests show a miscompile. The *_store_after_inv functions are
# missing a required `S_WAITCNT vmcnt(0)`; the *_store_only functions are the
# expected behaviour for comparison.
#
# What happens:
#  - On targets without vscnt (gfx942, gfx950), VMEM stores are counted on
#    vmcnt (LOAD_CNT), together with loads and the BUFFER_INV/GLOBAL_INV
#    invalidates (VMEM_INV_ACCESS).
#  - SIInsertWaitcnts' simplifyVmemInvOnlyWait drops the vmcnt wait when the
#    only pending LOAD_CNT event is VMEM_INV_ACCESS, because invalidates do not
#    write VGPRs. However, it subtracts the STORE_CNT events from the pending
#    set first ("LOAD_CNT also includes store events on targets without
#    VScnt"). With a store and an invalidate both pending, the pending set
#    collapses to {VMEM_INV_ACCESS} and the wait is removed although it is
#    still needed to drain the store.
#  - Soft waits: the memory legalizer's soft vmcnt(0) for a release (e.g.
#    workgroup scope with tgsplit, which emits no BUFFER_WBL2) or a volatile
#    store is erased when it follows `acquire (buffer_inv); store`. The store
#    is then not visible before the release.
#  - Returns: the all-zero wait before a return gets the same simplification,
#    so the callee returns with the store in flight. The caller models the call
#    as draining everything but STORE_CNT (unused without vscnt), so it also
#    drops its own waits for that store.
#  - Introduced by e775ea816fc4 ("[AMDGPU] Track BUFFER_INV during waitcnt
#    insertion", #220694). gfx90a and older (BUFFER_WBINVL1*, no
#    VMEM_INV_ACCESS) and gfx12+ (separate storecnt) are not affected.
#    End-to-end IR reproducer: acquire fence; store; workgroup release store
#    in an "amdgpu-tg-split" kernel, at -mtriple=amdgpu9.42-amd-amdhsa.
#
# What to do:
#  - Fix simplifyVmemInvOnlyWait to not subtract the store events: only clear
#    LOAD_CNT when (PendingEvents & getWaitEvents(LOAD_CNT)) ==
#    VMEM_INV_ACCESS. This is NFC on gfx12+.
#  - Regenerate this test: both *_store_after_inv functions must then keep
#    their `S_WAITCNT vmcnt(0)`, like the *_store_only functions, and drop
#    this TODO.
#  - Re-check the waits removed by e775ea816fc4 in a-v-flat-atomicrmw.ll and
#    flat-atomicrmw-f{add,sub}.ll for the same pattern.
#  - AMDGPUNewInsertWaitcnts::removeVmemInvOnlyWait ports the same logic and
#    must get the same fix.

---
name:            soft_wait_store_after_inv
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2
    ; GFX94-LABEL: name: soft_wait_store_after_inv
    ; GFX94: liveins: $vgpr0_vgpr1, $vgpr2
    ; GFX94-NEXT: {{  $}}
    ; GFX94-NEXT: BUFFER_INV 1, implicit $exec
    ; GFX94-NEXT: GLOBAL_STORE_DWORD $vgpr0_vgpr1, $vgpr2, 0, 0, implicit $exec
    ; GFX94-NEXT: S_ENDPGM 0
    BUFFER_INV 1, implicit $exec
    GLOBAL_STORE_DWORD $vgpr0_vgpr1, $vgpr2, 0, 0, implicit $exec
    S_WAITCNT_soft 3952
    S_ENDPGM 0
...
---
name:            soft_wait_store_only
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2
    ; GFX94-LABEL: name: soft_wait_store_only
    ; GFX94: liveins: $vgpr0_vgpr1, $vgpr2
    ; GFX94-NEXT: {{  $}}
    ; GFX94-NEXT: GLOBAL_STORE_DWORD $vgpr0_vgpr1, $vgpr2, 0, 0, implicit $exec
    ; GFX94-NEXT: S_WAITCNT .Vmcnt_0
    ; GFX94-NEXT: S_ENDPGM 0
    GLOBAL_STORE_DWORD $vgpr0_vgpr1, $vgpr2, 0, 0, implicit $exec
    S_WAITCNT_soft 3952
    S_ENDPGM 0
...
---
name:            return_store_after_inv
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: false
body:             |
  bb.0:
    liveins: $sgpr30_sgpr31, $vgpr0_vgpr1, $vgpr2
    ; GFX94-LABEL: name: return_store_after_inv
    ; GFX94: liveins: $sgpr30_sgpr31, $vgpr0_vgpr1, $vgpr2
    ; GFX94-NEXT: {{  $}}
    ; GFX94-NEXT: S_WAITCNT .Vmcnt_0_Expcnt_0_Lgkmcnt_0
    ; GFX94-NEXT: BUFFER_INV 1, implicit $exec
    ; GFX94-NEXT: GLOBAL_STORE_DWORD $vgpr0_vgpr1, $vgpr2, 0, 0, implicit $exec
    ; GFX94-NEXT: S_SETPC_B64_return $sgpr30_sgpr31
    BUFFER_INV 1, implicit $exec
    GLOBAL_STORE_DWORD $vgpr0_vgpr1, $vgpr2, 0, 0, implicit $exec
    S_SETPC_B64_return $sgpr30_sgpr31
...
---
name:            return_store_only
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: false
body:             |
  bb.0:
    liveins: $sgpr30_sgpr31, $vgpr0_vgpr1, $vgpr2
    ; GFX94-LABEL: name: return_store_only
    ; GFX94: liveins: $sgpr30_sgpr31, $vgpr0_vgpr1, $vgpr2
    ; GFX94-NEXT: {{  $}}
    ; GFX94-NEXT: S_WAITCNT .Vmcnt_0_Expcnt_0_Lgkmcnt_0
    ; GFX94-NEXT: GLOBAL_STORE_DWORD $vgpr0_vgpr1, $vgpr2, 0, 0, implicit $exec
    ; GFX94-NEXT: S_WAITCNT .Vmcnt_0
    ; GFX94-NEXT: S_SETPC_B64_return $sgpr30_sgpr31
    GLOBAL_STORE_DWORD $vgpr0_vgpr1, $vgpr2, 0, 0, implicit $exec
    S_SETPC_B64_return $sgpr30_sgpr31
...
